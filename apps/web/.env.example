# Cloudflare R2 dashboard bundle access for local and Vercel environments.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=tibson-data
R2_DASHBOARD_PREFIX=dashboard
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...

# Optional: read generated dashboard JSON files from disk while developing.
# DASHBOARD_DATA_DIR=C:\path\to\dashboard-data
