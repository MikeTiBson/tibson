# Private GCS bucket used by the Vercel API routes.
TIBBIR_GCS_BUCKET=tibbir-data
TIBBIR_DASHBOARD_PREFIX=dashboard

# Use one of these in local/Vercel environments.
GCP_SA_KEY={"type":"service_account","project_id":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Optional: read generated dashboard JSON files from disk while developing.
# DASHBOARD_DATA_DIR=C:\path\to\dashboard-data
